# 开发环境变量
#
# 【API 基础地址】（内网穿透）
# 2026-09-23 试过内网穿透域名 http://wa9b8afb.natappfree.cc，**用不了**：
# 该域名不在服务器 .env 的 ALLOWED_HOSTS 里，Django 对本机所有请求一律回
# 400 Bad Request（连根路径都是）。要用隧道，先让运维在服务器 .env 补：
#   ALLOWED_HOSTS=...,wa9b8afb.natappfree.cc
#   CORS_ALLOWED_ORIGINS=...,http://localhost:8080
#   CSRF_TRUSTED_ORIGINS=...,http://wa9b8afb.natappfree.cc
# 否则改这里只会让本地开发整个连不上后端。生产地址在 .env.production，不受影响。
#
# 【2026-09-30 实测：开发环境**不加** /ylbbm，与生产不一致是故意的】
# 生产早就搬到 /ylbbm/api/ 下了（见 .env.production），但本机这台 47.108.29.34
# 的后端仍在 /api/ 下：
#     GET http://47.108.29.34/api/login       -> 405（后端在，只是不接 GET）
#     GET http://47.108.29.34/ylbbm/api/login -> 200 且 Content-Type: text/html
#                                                （返回的是前端 index.html）
# 也就是说这台机器上的 /ylbbm/ 只是个**静态前端目录**，/ylbbm/api/* 会被它的
# try_files 兜底成 index.html。若照着生产把 /ylbbm 加到这里，本地不会报错，
# 只会**静默拿到 HTML**：后端信封里的 code 取不到 -> unwrap() 按成功处理 ->
# 页面数据全空。所以开发环境保持 /api/，等运维把这台机器的 nginx 也改了再说。
VITE_API_BASE_URL=http://47.108.29.34

# 【部署前缀】
# 不要在此定义部署前缀。前缀唯一来源是 vite.config.js 的 base，
# 代码中统一读取 import.meta.env.BASE_URL。

# 标题
VITE_APP_TITLE=“意林杯”管乐展示活动报名系统
