# 生产环境变量
#
# 【部署前缀】
# 不要在此定义部署前缀。前缀唯一来源是 vite.config.js 的 base（production 下为 /ylbxt/），
# 代码中统一读取 import.meta.env.BASE_URL。

# API 基础地址
# 与 dist 严格一致（dist: window.location.protocol + "//bigapp.scbdc.edu.cn/ylbxt"）
VITE_API_BASE_URL=https://bigapp.scbdc.edu.cn/ylbxt

# 标题
VITE_APP_TITLE=「意林杯」管乐展示活动报名系统
