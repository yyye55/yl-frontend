# 开发环境变量
#
# 【API 基础地址】
# 默认指向本地 mock 服务（与 `npm run dev:mock` 一起启动，端口 8787）。
# 想连真实后端：把下面一行换成 https://bigapp.scbdc.edu.cn/ylbxt
VITE_API_BASE_URL=http://127.0.0.1:8787/ylbxt

# 【部署前缀】
# 不要在此定义部署前缀。前缀唯一来源是 vite.config.js 的 base，
# 代码中统一读取 import.meta.env.BASE_URL。

# 标题
VITE_APP_TITLE=「意林杯」管乐展示活动报名系统
